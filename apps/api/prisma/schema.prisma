generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vehicles      Vehicle[]
  refreshTokens RefreshToken[]
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A car owned by a user. Several users may own a car with the same VIN
/// over time, so the spec lives in VehicleSpec, shared by VIN.
model Vehicle {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vin       String       @db.VarChar(17)
  spec      VehicleSpec  @relation(fields: [vin], references: [vin])
  nickname  String?      @db.VarChar(60)
  /// Paint color chosen by the user (hex). A VIN does not encode the color.
  color     String       @default("#9aa0a6") @db.VarChar(7)
  /// What the owner declares from the registration card (carte grise):
  /// constructeur, type commercial, type constructeur, first registration.
  /// Hints for the agent.
  declaredMake      String? @db.VarChar(40)
  declaredModel     String? @db.VarChar(60)
  declaredVariant   String? @db.VarChar(80)
  /// Carte grise box P.3 ("Énergie"): Essence, Diesel, Hybride, Électrique, GPL
  declaredFuel      String? @db.VarChar(20)
  firstRegistration String? @db.VarChar(10)
  /// Odometer reading entered by the owner (km), for the maintenance plan.
  mileageKm         Int?
  mileageUpdatedAt  DateTime?
  maintenanceRecords MaintenanceRecord[]
  events            VehicleEvent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, vin])
  @@index([userId])
}

enum Model3DStatus {
  SEARCHING
  FOUND
  NOT_FOUND
}

/// 3D model chosen by the AI agent for one make + model + generation,
/// shared by every owner of that car. Shown with the Sketchfab viewer.
model CarModel3D {
  /// "make|model|generation" in lower case (see src/lib/model3d.ts).
  key          String        @id @db.VarChar(200)
  status       Model3DStatus @default(SEARCHING)
  sketchfabUid String?       @db.VarChar(40)
  /// false: no model of this exact version exists, this is the closest one
  /// of the same generation (e.g. a Panda City Life for a standard Panda).
  exactMatch   Boolean       @default(true)
  /// "sketchfab": artist model shown with the Sketchfab viewer.
  /// "generated": GLB generated by AI (TRELLIS) from a free photo.
  source       String        @default("sketchfab") @db.VarChar(20)
  /// Generated GLB, relative to the models folder/CDN (source = "generated").
  glbFile      String?       @db.VarChar(200)
  /// Real photos of the exact version (source = "photos"):
  /// [{ angle, url, pageUrl, author, license, title }]
  photos       Json?
  title        String?
  author       String?
  license      String?
  viewerUrl    String?
  thumbnailUrl String?
  /// Why the agent picked this model, or why none matched.
  reason       String?
  attempts     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

enum SpecStatus {
  PENDING
  READY
  FAILED
}

/// Result of the AI agent, cached per VIN: each VIN is researched once,
/// whatever the number of users who add it.
model VehicleSpec {
  vin        String      @id @db.VarChar(17)
  status     SpecStatus  @default(PENDING)
  make       String?
  model      String?
  modelYear  Int?
  bodyType   String?
  /// Full structured profile (see src/agent/schema.ts).
  data       Json?
  error      String?
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  vehicles   Vehicle[]

  @@index([status])
}

enum PlanStatus {
  PENDING
  READY
  FAILED
}

/// Manufacturer-style maintenance schedule for one car version and engine,
/// generated once by the AI agent and shared by every owner of that version.
model MaintenancePlan {
  /// "make|model|generation|variant|engine|fuel" in lower case.
  key       String     @id @db.VarChar(250)
  status    PlanStatus @default(PENDING)
  /// [{ id, name, category, action, intervalKm, intervalMonths, note }]
  items     Json?
  notes     String?
  confidence String?   @db.VarChar(10)
  error     String?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

/// "Done" marks: the owner did this maintenance item at this mileage.
model MaintenanceRecord {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  itemId    String   @db.VarChar(60)
  /// Snapshot of the item name and category, so history stays readable.
  itemName  String?  @db.VarChar(120)
  category  String?  @db.VarChar(30)
  doneAtKm  Int
  /// What the owner paid (parts + labour), optional, for spending reports.
  costTnd   Float?
  note      String?  @db.VarChar(300)
  doneAt    DateTime @default(now())

  @@index([vehicleId, itemId])
}

/// Prices of one maintenance item for one car version, looked up by the AI
/// agent on Tunisian shops when an owner opens it; cached and shared 7 days.
model PartPrices {
  /// "<maintenance plan key>|<item id>"
  key       String     @id @db.VarChar(320)
  status    PlanStatus @default(PENDING)
  /// [{ part, shop, product, brand, reference, priceTnd, url, imageFile, enriched }]
  offers    Json?
  /// { minTnd, maxTnd, note } labour estimate at a garage
  labor     Json?
  note      String?
  /// Original manufacturer (OE) part numbers found for this car
  oemRefs   String[]   @default([])
  error     String?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

/// Every change an owner makes to a car (and when its analysis finished):
/// the history of the car, shown as a timeline and used for reports.
model VehicleEvent {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// vehicle_added, analysis_ready, mileage_updated, maintenance_done,
  /// maintenance_undone, color_changed, nickname_changed, info_corrected
  type      String   @db.VarChar(40)
  data      Json?
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}
