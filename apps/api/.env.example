NODE_ENV=development
PORT=3100

DATABASE_URL=postgresql://carai:carai@localhost:5433/carai?schema=public
REDIS_URL=redis://localhost:6379

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-min

# Claude API key (https://console.anthropic.com). Never commit the real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Number of VIN research jobs a worker process runs at the same time.
AGENT_CONCURRENCY=4

# SMTP server used to send login codes. When empty in development,
# codes are printed in the API logs instead of being emailed.
SMTP_URL=
MAIL_FROM="Car AI <no-reply@example.com>"

# Comma-separated list of allowed web origins (mobile apps send no Origin).
CORS_ORIGINS=
